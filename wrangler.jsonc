{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easydesk",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "iconv-lite": "./src/shims/iconv-lite.cjs"
  },
  "vars": {
    "NODE_ENV": "production",
    "STORAGE_PROVIDER": "r2",
    "DB_PROVIDER": "d1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "easydesk-prod-db",
      "database_id": "ai-studio-easydesk-d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "easydesk-prod-storage",
      "preview_bucket_name": "easydesk-preview-storage"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/uploads/*"
    ]
  }
}
