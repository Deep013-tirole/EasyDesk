{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easydesk",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "iconv-lite": "./src/shims/iconv-lite.cjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/uploads/*"
    ]
  }
}
